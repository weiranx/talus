# intervals.icu: Settings > Developer Settings > API key. Athlete id looks like i123456.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Optional fallback: unofficial Garmin library. Reuses tokens from ~/.garminconnect if present.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKENSTORE=~/.garminconnect

# Where Talus keeps its SQLite database and raw activity files.
TALUS_DATA_DIR=./data
