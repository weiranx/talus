# intervals.icu: Settings > Developer Settings > API key. Athlete id looks like i123456.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Optional fallback: unofficial Garmin library. Reuses tokens from ~/.garminconnect if present.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKENSTORE=~/.garminconnect

# Where Talus keeps its SQLite database and raw activity files.
TALUS_DATA_DIR=./data

# AI coach. Leave empty to see rule-based text only.
ANTHROPIC_API_KEY=
# Default coach model for both modes (otherwise Haiku 5.5 for the brief, Opus 5.5 for analysis);
# the Settings screen overrides it per mode.
# TALUS_COACH_MODEL=claude-opus-5-5

# Accounts. Anyone who can reach the app can sign up unless this is "closed".
# TALUS_SIGNUP=open
# Monthly coach spending ceiling per account, in USD, on the server's Anthropic key. The owner has none.
# TALUS_COACH_CAP_USD=5
# Encrypts saved intervals.icu keys. Default: data/secret.key, made on first use.
# TALUS_SECRET_KEY=
# Set to 1 when served over HTTPS.
# TALUS_SECURE_COOKIE=0

# Sign in with Google: an OAuth client (Web application) from Google Cloud, with redirect URI
# http://localhost:3000/api/auth/google/callback. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The web app's address, for the Google redirect when it isn't http://localhost:3000.
# TALUS_PUBLIC_URL=http://localhost:3000
